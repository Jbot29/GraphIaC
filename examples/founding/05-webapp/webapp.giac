# Chapter 5 — the web server
#
#   https://app.yourco.com
#     -> ALB (HTTPS, HTTP redirected)
#     -> ECS Fargate task running your container
#     -> RDS Postgres, reachable from that task and nothing else
#
# The other track. Chapters 3 and 4 assume you're starting from nothing;
# this one assumes you already have a Django/Rails/Express app and a
# schema, and you are not rewriting it as functions to get it deployed.
#
#   ./push.sh                                     # build + push your image
#   python -m GraphIaC graphiac --infra_file webapp.giac run
#
# Expect two or three runs. The certificate takes minutes to validate and
# Postgres takes five to ten to come up; everything downstream shows
# ⊘ BLOCKED until they do, then picks up where it left off. Nothing in this
# file changes between runs.
#
# No VPC is created. A fresh AWS account already has a default one with a
# public subnet per availability zone, and Fargate tasks there reach ECR
# without a NAT gateway ($32/month before you serve a request). The tasks
# hold public IPs and are still unreachable — their security group admits
# the load balancer and nobody else.

company  = "yourco"          # the only name you change
domain   = "${company}.com"
app-host = "app.${domain}"
region   = "us-east-2"

hz : HostedZone(domain_name: domain)

# Chapter 2's certificate lives in us-east-1 because CloudFront requires
# it. An ALB needs one in its own region, so this is a second certificate,
# for the subdomain only.
cert : ACMCertificate(domain_name: app-host, region: region,
                      subject_alternative_names: [])

images : EcrRepository(name: "${company}-web", region: region)

lb : ALB(name: "${company}-lb", region: region)

db : RDSPostgres(name: "${company}-db", region: region, db_name: company,
                 instance_class: "db.t4g.micro", allocated_storage: 20,
                 backup_retention_days: 7)

cluster   : EcsCluster(name: company, region: region)
task-role : EcsTaskRole(name: "${company}-task-role")

# image and DATABASE_HOST are attribute references — they have no value
# until the repository and the database exist, so this service is BLOCKED
# until both do. That is the whole of the "wait for the database" logic.
web : EcsService(name: "${company}-web", region: region,
                 image: images.uri, container_port: 8000,
                 cpu: "512", memory: "1024", desired_count: 2,
                 env: {DATABASE_HOST: db.endpoint,
                       DATABASE_NAME: company,
                       DATABASE_USER: "postgres",
                       PORT: "8000"})

cert      -> hz                              # DNS validation records
cert      -> lb                              # HTTPS listener (gates lb until ISSUED)
lb        -> hz : (domain_name: app-host)    # A alias record
cluster   -> web                             # which cluster it runs in
task-role -> web                             # pull images, write logs
lb        -> web : (health_check_path: "/healthz")   # target group + listener + SG rule
web       -> db : (role_g_id: task-role)     # SG rule + credentials, both directions of the pain

# --- declared invariants: independent checks, never the provisioning code ---
? db-private(db)   # no public address, nothing open to 0.0.0.0/0
